{
  "name": "interview-gacha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron-vite dev",
    "desktop:build": "tsc -b && electron-vite build",
    "desktop:mac": "npm run desktop:build && electron-builder --mac"
  },
  "build": {
    "appId": "com.joynnncode.interviewgacha",
    "productName": "Interview Gacha",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/questions.seed.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Gacha records your spoken answers so you can play them back. Recordings stay on this Mac and are never uploaded."
      },
      "identity": null
    },
    "extraResources": [
      {
        "from": "public/questions.example.json",
        "to": "questions.example.json"
      }
    ]
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  }
}
